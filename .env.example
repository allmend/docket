DATABASE_URL=postgres://docket:docket@localhost:5432/docket?sslmode=disable
HTTP_PORT=8081
# At least 32 bytes; generate your own with: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production
# Initial admin password, used only when the database is empty.
SEED_PASSWORD=dev-admin-password
MODE=all
